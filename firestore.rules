rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and write access for users during session play
    match /users/{userId} {
      allow read, write: if true;
    }
    // Allow public read and write access for transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
  }
}
